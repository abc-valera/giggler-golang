# Template for /etc/giggler-golang/<instance>/stage.env on the staging VPS
# host (bind-mounted read-only into the container's /etc/giggler-golang, see
# containers.nix). <instance> is the container name, e.g. "stage".
#
# Copy this file to secrets/stage.env locally (already gitignored, see
# ./README.md), fill in real values, then deploy it to the VPS out-of-band
# from the NixOS config, e.g.:
#   scp secrets/stage.env deploy@<vps>:/tmp/stage.env
#   ssh deploy@<vps> 'sudo install -m 600 -o root -g root /tmp/stage.env /etc/giggler-golang/stage/stage.env && sudo systemctl restart container@stage'

### Application ###

GIGGLER_IS_HTTP_PPROF_INTERFACE_ENABLED=false
GIGGLER_IS_MUTEX_BLOCK_PPROF_ENABLED=false

GIGGLER_JWT_SIGN_KEY=

GIGGLER_ACCESS_TOKEN_DURATION=15m
GIGGLER_REFRESH_TOKEN_DURATION=24h

### Infrastructure ###

# stdout | nop
GIGGLER_LOGGER=stdout
# debug | info | warn | error
GIGGLER_LOGGER_LEVEL=info

GIGGLER_TRACER=

GIGGLER_FS=local
GIGGLER_LOCAL_DSN=/var/lib/giggler-webapi/files

GIGGLER_EMAILER=dummy

# postgresql.nix runs Postgres natively with peer auth over the unix socket:
# POSTGRES_USER must match the giggler-webapi OS/systemd user (see
# instance.nix) so peer auth maps it to the same-named Postgres role.
# ensureDBOwnership creates the database under that same name, hence
# POSTGRES_DB matches too.
POSTGRES_USER=giggler-webapi
POSTGRES_PASSWORD=
POSTGRES_DB=giggler-webapi
POSTGRES_HOST=/run/postgresql
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

### Networking ###
GIGGLER_ORIGIN_URL=https://stage.giggler.example.com/
GIGGLER_WEBAPI_PORT=8080
