# This is an example of a .env file.
#
# It contains all the env vars that are used in the application,
# as well as their possible values.

### Application ###

GIGGLER_IS_HTTP_PPROF_INTERFACE_ENABLED=false
GIGGLER_IS_MUTEX_BLOCK_PPROF_ENABLED=false

GIGGLER_JWT_SIGN_KEY=

GIGGLER_ACCESS_TOKEN_DURATION=15m
GIGGLER_REFRESH_TOKEN_DURATION=24h

### Infrastructure ###

# stdout | nop
GIGGLER_LOGGER=stdout
# debug | info | warn | error # TODO: implement this
GIGGLER_LOGGER_LEVEL=debug

GIGGLER_TRACER= #

GIGGLER_FS=local
GIGGLER_LOCAL_DSN=./var/files

GIGGLER_EMAILER=dummy

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=giggler-golang
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

GRAFANA_PORT=8091

### Networking ###
GIGGLER_ORIGIN_URL=https://example.com/
GIGGLER_WEBAPI_PORT=8080
